# AI Infographic Studio - client environment
# Vite only exposes variables prefixed with VITE_ to the browser. Never put secrets here.

# Base path or absolute URL of the Express API.
# Keep "/api" to go through the Vite dev proxy (development) or a reverse proxy (production).
VITE_API_BASE_URL=/api

# Development only: where the Vite dev server forwards /api requests.
VITE_DEV_API_PROXY=http://localhost:5000
VITE_DEV_PORT=5173

# Public address of the app, used for link previews (logo, title and description
# when a link is shared on WhatsApp, Telegram, Facebook, LinkedIn, X...). Set it
# before "npm run build" for production, e.g. https://app.example.com (no slash
# at the end). Leave it empty for local development.
VITE_SITE_URL=
