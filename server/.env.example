# =============================================================================
# AI Infographic Studio - server environment
# Copy this file to server/.env and fill in real values. server/.env is git-ignored.
# Run "npm run check:env" from the repo root to validate your configuration.
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=debug
# Number of reverse-proxy hops in front of the API (0 locally, usually 1 on Render/Railway/Nginx).
TRUST_PROXY=0

# ---- Public URLs ------------------------------------------------------------
# Browser origin of the React client (CORS allow-list, password-reset links).
CLIENT_URL=http://localhost:5173
# Public base URL of this API (the OAuth issuer; the MCP URL is SERVER_URL + /mcp).
SERVER_URL=http://localhost:5000
# Optional comma-separated list of extra origins allowed by CORS.
CORS_ORIGINS=
# Set to true to serve the built client (client/dist) from this server in production.
SERVE_CLIENT=false

# ---- Database (required; the API reports "not ready" until it can connect) ---
# Local:  mongodb://127.0.0.1:27017   (no MongoDB installed? run "npm run db:dev" in another terminal)
# Atlas:  paste the mongodb+srv:// URI from the Atlas "Connect" dialog.
# If the URI names no database, MONGODB_DB_NAME is used.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=ai_infographic_studio
# Seconds between reconnection attempts when the first connection fails.
MONGODB_RETRY_SECONDS=15

# ---- Security (required) ------------------------------------------------------
# Generate each value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET keys the HMAC that protects stored session and reset tokens (minimum 32 characters).
SESSION_SECRET=
# ENCRYPTION_KEY must be exactly 64 hex characters (32 bytes). It is the AES-256-GCM key used
# to encrypt provider API keys at rest. Changing it makes stored keys unreadable.
ENCRYPTION_KEY=

# ---- Sessions and cookies ------------------------------------------------------
# "Remember me" sessions last SESSION_TTL_DAYS; other sessions end when the browser
# closes and expire server-side after SESSION_SHORT_TTL_HOURS.
SESSION_TTL_DAYS=30
SESSION_SHORT_TTL_HOURS=12
# lax works when the client and API share a site (dev proxy, same domain, reverse proxy).
# Use none (needs secure cookies) only when the client is served from a different site.
COOKIE_SAMESITE=lax
# Leave empty to use secure cookies automatically in production.
COOKIE_SECURE=
COOKIE_DOMAIN=
# Set to false to close public sign-ups.
SIGNUP_ENABLED=true
PASSWORD_RESET_TTL_MINUTES=60

# ---- Sign in with Google (optional) ---------------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (type
# Web application). Authorized redirect URI: CLIENT_URL + /api/auth/google/callback
# e.g. http://localhost:5173/api/auth/google/callback. Leave both empty to hide
# the Google button. The secret stays on the server; never put it in the client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only when the browser reaches the API on another address than CLIENT_URL.
GOOGLE_REDIRECT_URI=

# ---- Object storage ------------------------------------------------------------
# local = files on disk under STORAGE_LOCAL_DIR (development only)
# s3    = any S3-compatible bucket (AWS S3, Cloudflare R2, MinIO, Backblaze B2)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# s3: use a bucket DEDICATED to AI Infographic Studio, with an API token scoped to that
# bucket only (Cloudflare R2: "Object Read & Write" on this one bucket). Never
# reuse another application's bucket or keys. Files stay private; the bucket
# does not need public access.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional and not required: files are served by the API, never from a public URL.
S3_PUBLIC_BASE_URL=
# Optional folder inside the bucket per environment, e.g. prod/ or staging/.
STORAGE_KEY_PREFIX=
# The app refuses to write into a bucket that already holds another
# application's files. Set true only if sharing is a deliberate decision; it
# then REQUIRES STORAGE_KEY_PREFIX, and the app can only write or delete
# inside that folder.
STORAGE_ALLOW_SHARED_BUCKET=false

# ---- Email (password reset) ----------------------------------------------------
# console = development only: emails, including reset links, are written to the
#           server log and NOT delivered. Refused when NODE_ENV=production.
# smtp    = deliver through the SMTP server below (required in production).
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=AI Infographic Studio <no-reply@example.com>

# ---- Rate limiting -------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
# Per-IP limit for sign-up, login and password-reset requests in the same window.
AUTH_RATE_LIMIT_MAX=30
# Per-account limit for failed logins and reset requests in the same window.
LOGIN_EMAIL_RATE_LIMIT_MAX=10

# ---- AI provider (Kie.ai) ------------------------------------------------------
# Each user saves their OWN Kie.ai key in API Settings; it is encrypted with
# ENCRYPTION_KEY. There is no shared platform key here on purpose.
KIE_API_BASE_URL=https://api.kie.ai
# Waiting longer than this for a createTask answer makes the submission
# "uncertain": it is never resent automatically (avoids double charges).
PROVIDER_SUBMIT_TIMEOUT_MS=30000
PROVIDER_STATUS_TIMEOUT_MS=15000
# Public https base URL of THIS API (for example https://api.yourdomain.com).
# When set, Kie.ai calls back /api/webhooks/kie/... so uncertain submissions can
# be reconciled. Leave empty in local development (no callback is sent).
PUBLIC_WEBHOOK_BASE_URL=
# Kie.ai File Upload API host (free; files deleted after 24 hours). Used only if
# a job references a stored image; infographics are generated from text alone.
KIE_UPLOAD_BASE_URL=https://kieai.redpandaai.co

# ---- Uploads and stored images ---------------------------------------------------
# Admin branding image upload limit (JPEG, PNG or WebP; checked by content).
UPLOAD_MAX_MB=10
# Largest generated infographic accepted when it is saved.
ASSET_DOWNLOAD_MAX_MB=30

# ---- MCP server and OAuth (MCP Connection page) --------------------------------------
# The MCP URL is SERVER_URL + /mcp and SERVER_URL is the OAuth issuer, so
# SERVER_URL must be the public HTTPS address in production. Claude and
# ChatGPT connect from their own servers: a localhost URL only works for apps
# on the same computer (for example Claude Code).
MCP_ENABLED=true
OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
# A connection that is not used for this many days ends (refresh tokens rotate).
OAUTH_REFRESH_TOKEN_TTL_DAYS=30
# Client registration: Client ID Metadata Documents and Dynamic Client Registration.
OAUTH_CIMD_ENABLED=true
OAUTH_DCR_ENABLED=true
MCP_RATE_LIMIT_PER_MINUTE=120

# ---- Background job worker -----------------------------------------------------
# Runs inside the API process. Jobs live in MongoDB, so they survive restarts.
WORKER_ENABLED=true
# Jobs processed at the same time by this process, and per user.
WORKER_CONCURRENCY=4
JOB_USER_CONCURRENCY=2
# How often the worker looks for due jobs.
JOB_POLL_INTERVAL_MS=2000
# Send attempts for errors where the provider certainly did NOT create a task
# (rate limit, maintenance). Backoff starts at JOB_RETRY_BASE_MS and doubles.
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_MS=15000
# Status polling interval grows from MIN to MAX while a task is running.
JOB_POLL_MIN_MS=4000
JOB_POLL_MAX_MS=30000
# A crashed worker's job is picked up again after its lease expires.
JOB_LEASE_MS=90000
JOB_IMAGE_TIMEOUT_MINUTES=15
# How long an uncertain submission waits for the provider callback.
JOB_RECONCILE_MINUTES=15
# New jobs per user per minute.
JOB_CREATE_RATE_LIMIT_PER_MINUTE=20

# ---- Owner admin bootstrap (one time; see docs/admin-setup.md) ----------------
# The script takes the email on the command line (typed twice). If ADMIN_PASSWORD
# is set it is used as the admin password (min 12 chars, letters + numbers);
# otherwise the script prompts for it with hidden input. Remove it after the run.
ADMIN_EMAIL=
ADMIN_PASSWORD=
